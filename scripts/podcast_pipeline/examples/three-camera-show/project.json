{
 "show": {
  "name": "Example Show",
  "slug": "example-show",
  "subtitle": "Reels and full episodes from one shoot"
 },
 "footage_root": "/path/to/SHOOT_FOLDER",
 "out_root": "REELS",
 "outputs": {
  "vertical": "",
  "horizontal": "horizontal",
  "quad": "web/quad",
  "fcpxml": "FCPXML",
  "fcp_media": "FCP MEDIA"
 },
 "work": "work",
 "cache": "~/.cache/podcast-editing-pipeline/example-show",
 "venv": "~/.venvs/podcast-editing-pipeline",
 "personmask": "~/.cache/podcast-editing-pipeline/bin/personmask",
 "lut": "luts/your_camera_lut.cube",
 "timeline_fps": "24000/1001",
 "source_resolution": [
  3840,
  2160
 ],
 "cameras": {
  "a7s3": {
   "label": "A7S III",
   "role": "two_shot",
   "reference": true,
   "rate": "24000/1001",
   "log": true,
   "timecode": "ignore",
   "grade": "lut",
   "h_closeup": "half"
  },
  "fx3": {
   "label": "FX3",
   "role": "guest",
   "files": "VIDEO FOOTAGE/FX3/*.MP4",
   "rate": "24000/1001",
   "log": true,
   "timecode": "ignore",
   "grade": "lut",
   "h_closeup": "full"
  },
  "osmo": {
   "label": "Osmo Pocket 3",
   "role": "wide",
   "files": "VIDEO FOOTAGE/OSMO/DJI/*.MP4",
   "rate": "25",
   "log": false,
   "timecode": "tmcd",
   "grade": "filter",
   "filter": "colorlevels=rimin=0.13:gimin=0.13:bimin=0.13:rimax=0.61:gimax=0.61:bimax=0.61:romin=0.16:gomin=0.16:bomin=0.16:romax=0.75:gomax=0.75:bomax=0.75,eq=saturation=1.3",
   "vertical_crop": [
    1380,
    230
   ]
  }
 },
 "recorder": {
  "label": "Rodecaster",
  "files": "AUDIO/**/Stereo Mix.wav",
  "mix": "Stereo Mix.wav"
 },
 "people": {
  "guest": {
   "label": "Guest",
   "camera": "fx3",
   "face_x": 1720,
   "face_y": 430,
   "mic": "Track1-Combo 1.wav",
   "face_x_by_session": {
    "2": 1580
   }
  },
  "host": {
   "label": "Host",
   "camera": "a7s3",
   "face_x": 2240,
   "face_y": 820,
   "mic": "Track2-Combo 2.wav"
  },
  "cohost": {
   "label": "Co-host",
   "camera": "a7s3",
   "face_x": 500,
   "face_y": 700,
   "mic": "Track3-Combo 3.wav"
  }
 },
